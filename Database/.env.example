# Database configuration for Network Device Inventory - Database container

# Choose database client: "sqlite" (default) or "pg" (PostgreSQL)
DB_CLIENT=sqlite

# For SQLite (relative to this Database directory)
DATABASE_URL=sqlite://./data/devices.db

# For PostgreSQL (example)
# DATABASE_URL=postgres://appuser:dbuser123@localhost:5432/devices

# SSL for PostgreSQL connections (true/false)
DB_SSL=false
